---
// Placeholder for a photo that has not been taken yet. Keeps the layout
// fixed so a real image can replace it later without anything moving.
interface Props {
  label: string;
  ratio?: string; // CSS aspect-ratio, e.g. "4 / 5"
  class?: string;
}
const { label, ratio = '4 / 3', class: className } = Astro.props;
---
<div class:list={['image-slot', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Image placeholder: ${label}`}>
  <span>[{label}]</span>
</div>

<style>
  .image-slot {
    display: grid;
    place-items: center;
    width: 100%;
    padding: 1rem;
    border: 1px dashed currentColor;
    border-radius: var(--radius-card-lg);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
