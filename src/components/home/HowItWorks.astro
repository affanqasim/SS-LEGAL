---
import ImageSlot from '../ImageSlot.astro';
import { site } from '../../data/site';

const steps = [
  {
    title: 'Tell us what has happened',
    text: 'Fill in the short form with your details and a summary of the dispute. Add any documents you already have.',
  },
  {
    title: 'Choose a time',
    text: 'Pick a slot that suits you. You will get a confirmation by email straight away.',
  },
  {
    title: 'A solicitor calls you',
    text: 'At the time you booked, a solicitor calls you to discuss your situation and the options open to you.',
  },
];
---
<section class="how" aria-labelledby="how-title">
  <div class="container grid">
    <div class="intro" data-reveal>
      <p class="label">How it works</p>
      <h2 id="how-title">Three steps to a call with a solicitor</h2>
      <ol>
        {steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="btn btn-light" href={site.bookingHref}>Start your enquiry</a>
    </div>
    <div class="photo" data-reveal>
      <ImageSlot label="Photo: Syed Safi Ullah, portrait" ratio="4 / 5" />
    </div>
  </div>
</section>

<style>
  /* Graphite section: sage text, green-light accents. No green text here. */
  .how {
    background: var(--graphite);
    color: var(--sage);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .grid { display: grid; gap: 3rem; align-items: center; }

  .label {
    font: 600 0.75rem / 1.4 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-light);
  }
  h2 { color: var(--sage-light); max-width: 16ch; }

  ol { margin: 2rem 0 2.5rem; padding: 0; list-style: none; }
  li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--sage) 22%, transparent);
  }
  li:last-child { border-bottom: 1px solid color-mix(in srgb, var(--sage) 22%, transparent); }
  .num { font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.2; color: var(--green-light); }
  h3 { font-size: 1.375rem; color: var(--sage-light); margin-bottom: 0.35rem; }
  li p { margin: 0; font-size: var(--text-sm); }

  .btn-light { background: var(--sage-light); color: var(--graphite); }

  .photo { color: var(--green-light); max-width: 440px; width: 100%; justify-self: center; }

  @media (min-width: 1000px) {
    .grid { grid-template-columns: 1.2fr 1fr; gap: 5rem; }
    .photo { justify-self: end; }
  }
</style>
